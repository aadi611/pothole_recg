# RoadWatch environment variables.
# Copy to .env and fill in. NEVER commit .env (NFR-SEC-04).
# Every var is prefixed ROADWATCH_ and read by core.config.Settings.

# --- Database ---
# Server runtime. Docker Compose sets this for you; override for a local PG.
ROADWATCH_DATABASE_URL=postgresql+psycopg://roadwatch:roadwatch@localhost:5432/roadwatch

# --- Auth ---
# CHANGE THIS. A predictable secret means forgeable device tokens.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ROADWATCH_JWT_SECRET=dev-only-change-me
ROADWATCH_JWT_ACCESS_TTL_MINUTES=30
ROADWATCH_JWT_REFRESH_TTL_DAYS=30

# --- Storage ---
# Evidence images. Served through authenticated expiring URLs, never as a
# public directory (NFR-SEC-05).
ROADWATCH_STORAGE_ROOT=storage

# --- Geocoding ---
# Nominatim requires a genuine contact in the User-Agent and rate-limits to
# 1 req/s. Put a real address here before running against the public instance.
ROADWATCH_NOMINATIM_URL=https://nominatim.openstreetmap.org
ROADWATCH_NOMINATIM_USER_AGENT=roadwatch/0.1 (contact: set-me@example.com)

# --- Runtime ---
ROADWATCH_LOG_LEVEL=INFO
ROADWATCH_APP_VERSION=0.1.0
